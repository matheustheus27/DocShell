# ==============================================================================
# DocShell - Dedicated Translation Task Worker Container (RabbitMQ Orchestrator)
# ==============================================================================
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir pika redis

COPY scripts/core /app/scripts/core
COPY scripts/rag /app/scripts/rag
COPY scripts/worker /app/scripts/worker
COPY scripts/worker/worker.py /app/worker.py

ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    RABBITMQ_HOST=rabbitmq \
    RABBITMQ_PORT=5672

CMD ["python", "/app/worker.py"]
