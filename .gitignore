# Build & Distribution Artifacts
dist/
build/
out/
target/

# Databases & Persistent Storage
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
publication/data/*
!publication/data/.gitkeep

# Docker Volumes & Local Service Data
mongo_data/
rabbitmq_data/
redis_data/
ollama_data/
rag_data/
datadog_data/

