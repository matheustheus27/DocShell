publication/.pdf-meta.tex
publication/documento-completo.md
publication/search_index.json
publication/translations_cache.json
.mermaid-config.json
mermaid-filter.err

# Python Bytecode, Virtual Environments & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node.js & PHP Dependencies & Logs
node_modules/
vendor/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Application & Container Logs
*.log
dist/logs/
dist/reports/

# Operating System & Temporary Files
.DS_Store
Thumbs.db
ehthumbs.db
*.swp
*.swo
*~
*.tmp
*.temp
.idea/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
